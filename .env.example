# sms:/imessage: link target for the "Text Dibs" CTAs.
# Leave empty to render the buttons disabled ("coming soon").
NEXT_PUBLIC_DIBS_PHONE_NUMBER=

# textdibs-backend base URL, used server-side to fetch listings.
# Defaults to http://localhost:8000 (uvicorn's default) if unset.
DIBS_API_URL=

# Same Supabase project/key textdibs-backend uses (see its .env). Used as a
# server-only fallback to read listings directly if DIBS_API_URL is
# unreachable. Leave empty to disable the fallback (errors surface normally).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
